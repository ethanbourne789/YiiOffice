{
  // Editor + `tsc` entry point: typechecks every file of the app against the
  // widest lib. The gate (`npm run typecheck`) runs the two split projects
  // below instead — tsconfig.main.json is stricter (no DOM lib), so code that
  // relies on a browser global in the main process only fails there.
  "extends": "./tsconfig.shared.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  "include": ["src", "tests", "electron.vite.config.ts", "vitest.config.ts"]
}
