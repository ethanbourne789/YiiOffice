{
  "name": "@yiioffice/slides",
  "productName": "YiiOffice Slides",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Pptx editor: byte-fidelity open + high-fidelity Konva render + element-patch save",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "devDependencies": {
    "@yiioffice/file-parse": "*",
    "@yiioffice/i18n": "*",
    "@yiioffice/pptx-engine": "*",
    "@yiioffice/pptx-ops": "*",
    "@yiioffice/pptx-render": "*",
    "@yiioffice/ui": "*",
    "@types/opentype.js": "^1.3.8",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "konva": "^10.9.0",
    "opentype.js": "^2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "author": "YiiOffice",
  "build": {
    "appId": "com.yiioffice.slides",
    "productName": "YiiOffice Slides",
    "electronVersion": "45.0.0",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "fileAssociations": [
      {
        "ext": "pptx",
        "name": "PowerPoint Presentation",
        "role": "Editor"
      }
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@yiioffice/electron-utils": "*",
    "harfbuzzjs": "^1.6.4",
    "pngjs": "^7.0.0",
    "utif2": "^4.1.0"
  }
}
