{
  "name": "@yiioffice/pdf",
  "productName": "YiiOffice PDF",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "PDF viewer module: PDF.js render + text layer + thumbnails, hosted by shell tabs",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
