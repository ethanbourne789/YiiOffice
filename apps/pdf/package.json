    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "devDependencies": {
    "@yiioffice/electron-utils": "*",
    "@yiioffice/font-metrics": "*",
    "@yiioffice/i18n": "*",
    "@yiioffice/pdf2docx": "*",
    "@yiioffice/ui": "*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.5",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@embedpdf/pdfium": "^2.15.1",
    "harfbuzzjs": "^1.6.4"
