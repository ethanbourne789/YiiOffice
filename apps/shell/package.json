{
  "name": "@yiioffice/shell",
  "productName": "YiiOffice",
  "version": "0.11.0",
  "license": "Apache-2.0",
  "homepage": "https://gitee.com/ethanbourne789/yiioffice",
  "private": true,
  "description": "Unified YiiOffice shell: one app hosting the docs and sheets modules behind a home/launcher window",
  "main": "out/main/index.js",
  "desktopName": "yiioffice.desktop",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "notices": "node ../../tools/gen-third-party-notices.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "electron-vite build && electron .",
    "dist:mac": "npm run notices && electron-vite build && electron-builder --mac --publish never",
    "dist:win": "npm run notices && electron-vite build && electron-builder --win --publish never",
    "dist:linux": "npm run notices && electron-vite build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@yiioffice/docs": "*",
    "@yiioffice/docx-engine": "*",
    "@yiioffice/electron-utils": "*",
    "@yiioffice/i18n": "*",
    "@yiioffice/pptx-engine": "*",
    "@yiioffice/pptx-render": "*",
    "@yiioffice/sheets": "*",
    "@yiioffice/slides": "*",
    "@yiioffice/ui": "*",
    "@yiioffice/xlsx-gateway": "*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "officecrypto-tool": "^0.0.19",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "author": "YiiOffice"
}
