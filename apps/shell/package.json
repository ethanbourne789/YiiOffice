{
  "name": "@yiioffice/shell",
  "productName": "YiiOffice",
  "version": "0.11.0",
  "license": "Apache-2.0",
  "homepage": "https://github.com/genspark-ai/yiioffice",
  "private": true,
  "description": "Unified YiiOffice shell: one app hosting the docs and sheets modules behind a home/launcher window",
  "main": "out/main/index.js",
  "desktopName": "yiioffice.desktop",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "notices": "node ../../tools/gen-third-party-notices.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "electron-vite build && electron .",
    "dist:mac": "npm run notices && electron-vite build && electron-builder --mac",
    "dist:win": "npm run notices && electron-vite build && electron-builder --win",
    "dist:linux": "npm run notices && electron-vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@yiioffice/docs": "*",
    "@yiioffice/docx-engine": "*",
    "@yiioffice/electron-utils": "*",
    "@yiioffice/cli": "*",
    "@yiioffice/i18n": "*",
    "@yiioffice/pptx-engine": "*",
    "@yiioffice/pptx-render": "*",
    "@yiioffice/sheets": "*",
    "@yiioffice/slides": "*",
    "@yiioffice/ui": "*",
    "@yiioffice/xlsx-gateway": "*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.7.6",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "officecrypto-tool": "^0.0.19",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  },
  "author": "YiiOffice"
}
