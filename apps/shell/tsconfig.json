{
  // Editor + `tsc` entry point: typechecks every file of the app against the
  // widest lib. The gate (`npm run typecheck`) runs the two split projects
  // instead — tsconfig.main.json is stricter (no DOM lib), so code that relies
  // on a browser global in the main process only fails there.

  "extends": "./tsconfig.shared.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/main",
    "src/preload",
    "src/shared",
    "../slides/src/main/env.d.ts",
    "../../packages/pdf2docx/src/bidi-js.d.ts",
    "../../packages/html2docx/src/raw.d.ts",
    "electron.vite.config.ts",
    "src/renderer",
    "tests"
  ]
}
