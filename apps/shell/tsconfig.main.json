{
  // Main process + preload. No DOM lib: these run in Node with Electron's
  // typings, and a DOM lib here silently re-points Electron-shaped globals
  // (`clipboard`, `Blob`, `File`, …) at their browser declarations.

  "extends": "./tsconfig.shared.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/main",
    "src/shared",
    "../slides/src/main/env.d.ts",
    "../../packages/pdf2docx/src/bidi-js.d.ts",
    "../../packages/html2docx/src/raw.d.ts",
    "electron.vite.config.ts"
  ]
}
