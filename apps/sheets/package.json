{
  "name": "@yiioffice/sheets",
  "productName": "YiiOffice Sheets",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform spreadsheet compatibility prototype",
  "license": "Apache-2.0",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build": "npm run native:build && electron-vite build",
    "native:build": "cargo build --release --manifest-path native/xlsx-engine/Cargo.toml --config native/xlsx-engine/.cargo/config.toml",
    "native:build:universal": "node scripts/build-sidecar-universal.mjs",
    "native:test": "cargo test --manifest-path native/xlsx-engine/Cargo.toml --config native/xlsx-engine/.cargo/config.toml",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "npm run native:test && npm run native:build && vitest run",
    "test:watch": "vitest",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "compat": "tsx scripts/verify-compatibility.ts",
    "benchmark": "tsx scripts/benchmark-xlsx.ts",
    "benchmark:large": "npm run native:build && tsx scripts/benchmark-large-xlsx.ts",
    "gate": "npm run typecheck && npm run fixtures && npm test && npm run compat"
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.333",
    "@yiioffice/docx-engine": "*",
    "@yiioffice/electron-utils": "*",
    "@yiioffice/file-parse": "*",
    "@yiioffice/i18n": "*",
    "@yiioffice/ui": "*",
    "@yiioffice/pptx-render": "*",
    "@yiioffice/xlsx-gateway": "*",
    "@univerjs/core": "1.2.0",
    "@univerjs/data-validation": "1.2.0",
    "@univerjs/docs": "1.2.0",
    "@univerjs/docs-ui": "1.2.0",
    "@univerjs/engine-formula": "1.2.0",
    "@univerjs/engine-render": "1.2.0",
    "@univerjs/find-replace": "1.2.0",
    "@univerjs/preset-sheets-conditional-formatting": "1.2.0",
    "@univerjs/preset-sheets-core": "1.2.0",
    "@univerjs/preset-sheets-data-validation": "1.2.0",
    "@univerjs/preset-sheets-drawing": "1.2.0",
    "@univerjs/preset-sheets-filter": "1.2.0",
    "@univerjs/preset-sheets-find-replace": "1.2.0",
    "@univerjs/preset-sheets-note": "1.2.0",
    "@univerjs/preset-sheets-sort": "1.2.0",
    "@univerjs/preset-sheets-table": "1.2.0",
    "@univerjs/sheets": "1.2.0",
    "@univerjs/sheets-conditional-formatting": "1.2.0",
    "@univerjs/sheets-filter": "1.2.0",
    "@univerjs/sheets-formula": "1.2.0",
    "@univerjs/sheets-formula-ui": "1.2.0",
    "@univerjs/sheets-table": "1.2.0",
    "@univerjs/sheets-ui": "1.2.0",
    "@univerjs/themes": "1.2.0",
    "@univerjs/ui": "1.2.0",
    "fast-xml-parser": "^5.3.4",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "^7.8.2",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-vite": "^6.0.0",
    "tsx": "^4.21.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "author": "YiiOffice"
}
