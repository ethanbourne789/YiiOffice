{
  // Renderer + preload: both are browser contexts, so they get the DOM lib
  // while the main process has its own stricter project. Tests stay out of the
  // typecheck scope (they run through vitest/esbuild), as before the split.

  "extends": "./tsconfig.shared.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src/preload", "src/renderer", "src/shared"]
}
