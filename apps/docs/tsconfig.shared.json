  // The main/renderer split below only adds lib, types and file sets.

  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@yiioffice/docx-engine": ["../../packages/docx-engine/src/index.ts"],
      "@yiioffice/font-metrics": ["../../packages/font-metrics/src/index.ts"],
