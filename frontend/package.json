{
  "name": "yiioffice-frontend",
  "version": "0.13.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node tools/build-renderers.mjs",
    "build:dev": "node tools/build-renderers.mjs",
    "dev": "npm run dev -w @yiioffice/shell",
    "lint": "eslint .",
    "test": "npm run test --workspaces",
    "test:coverage": "npm run test --workspaces -- --coverage",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^16.5.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  },
  "overrides": {
    "image-size": "^2.0.4"
  }
}
