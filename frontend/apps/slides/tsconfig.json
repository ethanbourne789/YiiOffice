{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Slides runs in the WebView2/WebKit shell, same baseline as the other apps,
    // so it shares the ES2022 lib (`.at()`/`replaceAll`/`Object.hasOwn` are used).
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src"]
}
