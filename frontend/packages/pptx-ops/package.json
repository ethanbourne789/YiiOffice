{
  "name": "@yiioffice/pptx-ops",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "pptx op layer: validated, journaled edit operations over an OpenedPptx (registry + executor + op docs), Electron-free so the app, tests and the yiioffice CLI share one implementation",
  "exports": {
    ".": "./src/index.ts",
    "./op-docs": "./src/op-docs.ts",
    "./font-size": "./src/font-size.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@yiioffice/docx-engine": "*",
    "@yiioffice/pptx-engine": "*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "vitest": "^5.0.5"
  }
}
