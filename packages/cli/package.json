{
  "name": "@yiioffice/cli",
  "version": "0.10.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "yiioffice: the YiiOffice command line (create, convert, read, edit and render documents) built on the same engines as the app; runs headless on the app's bundled Node runtime",
  "exports": {
    ".": "./src/index.ts",
    "./install": "./src/install.ts",
    "./control-protocol": "./src/control-protocol.ts"
  },
  "bin": {
    "yiioffice": "./bin/yiioffice"
  },
  "scripts": {
    "build": "node build.mjs && node collect-deps.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@yiioffice/docx-engine": "*",
    "@yiioffice/pdf2docx": "*",
    "@yiioffice/pptx-engine": "*",
    "@yiioffice/pptx-ops": "*",
    "@yiioffice/pptx-render": "*",
    "@yiioffice/xlsx-gateway": "*",
    "@tiptap/core": "3.31.0",
    "jsdom": "^28.0.0",
    "jszip": "^3.10.1",
    "numfmt": "^3.2.6",
    "pngjs": "^7.0.0",
    "undici": "^6.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}