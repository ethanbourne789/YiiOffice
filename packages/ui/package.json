{
  "name": "@yiioffice/ui",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Shared renderer UI components for the office apps (icons); styling stays per-app via the shared class names",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./screentip.css": "./src/screentip.css",
    "./color-picker.css": "./src/color-picker.css",
    "./dropdown.css": "./src/dropdown.css",
    "./find-panel.css": "./src/find-panel.css",
    "./ribbon-collapse.css": "./src/ribbon-collapse.css",
    "./markdown.css": "./src/markdown.css",
    "./image-dialogs.css": "./src/image-dialogs.css",
    "./image-viewer.css": "./src/image-viewer.css",
    "./fonts/*": "./src/fonts/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@yiioffice/i18n": "*",
    "@yiioffice/pptx-render": "*"
  }
}
